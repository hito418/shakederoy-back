    "neverthrow": "^8.2.0",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@repo/oxlint-config": "workspace:*",
    "@repo/ts-config": "workspace:*",
    "@types/bcrypt": "^5.0.2",
