{
  "name": "@repo/schemas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint -c oxlintrc.json src",
    "format": "prettier src --check",
    "typecheck": "tsc --noEmit",
    "migration:generate": "drizzle-kit generate",
    "migration:run": "drizzle-kit migrate",
    "drizzle:studio": "drizzle-kit studio --host=0.0.0.0",
    "build": "tsc --noEmit",
    "dev": "pnpm drizzle:studio"
  },
  "dependencies": {
    "drizzle-kit": "^0.22.8",
    "kysely": "^0.27.6",
    "@repo/oxlint-config": "workspace:*",
    "@repo/ts-config": "workspace:*",
    "drizzle-orm": "^0.31.4",
    "oxlint": "catalog:",
    "tsdown": "^0.20.1",
    "typescript": "catalog:",
    "pg": "catalog:"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/entities/*.d.ts",
      "import": "./dist/entities/*.js",
      "default": "./dist/entities/*.js"
    }
  }
}
